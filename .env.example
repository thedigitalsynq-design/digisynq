# ==============================================================================
# Active Directory Domain Controller - Environment Configuration
# ==============================================================================

# Fully Qualified Active Directory Realm (uppercase)
REALM=DIGISYNQ.COM

# NetBIOS / Workgroup Name (uppercase, 15 characters max)
DOMAIN=DIGISYNQ

# Administrator Password (must meet AD password complexity requirements:
# uppercase, lowercase, numbers, and symbols)
ADMIN_PASSWORD=P@ssw0rd2026!

# Upstream DNS Forwarder for resolving external internet domains
DNS_FORWARDER=8.8.8.8

# Samba log level (0: errors only, 1: standard, 3: debug)
SAMBA_LOG_LEVEL=1

# Disable Administrator password expiration (true/false)
DISABLE_ADMIN_PASSWORD_EXPIRATION=true

# Disable password complexity policy for users (true/false)
DISABLE_PASSWORD_COMPLEXITY=false
